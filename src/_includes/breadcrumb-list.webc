<div webc:root="override">
    <ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li webc:for="(item, index) of items" class="breadcrumb-list__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a rel="nofollow" :href="htmlBaseUrl(item.href)" itemprop="item">
                <span @text="item.text" itemprop="name"><span>
            </a>
            <meta itemprop="position" :content="index + 1" />
        </li>
    </ol>
</div>

<style webc:scoped>
    .breadcrumb-list {
    	list-style: none;
    	display: flex;
    	gap: 5px;
    	flex-wrap: wrap;
        padding-left: 0;
        margin: 8px 0;
    }
    .breadcrumb-list .breadcrumb-list__item:not(:last-child)::after {
        content: ">";
    }
</style>